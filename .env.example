# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; this file is committed, so never put real
# credentials here.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name used by the portfolio backend.
MONGODB_DB=ankita_portfolio

# Long random secret that protects every admin endpoint.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Max contact messages accepted from one IP address per hour.
CONTACT_RATE_LIMIT=5
